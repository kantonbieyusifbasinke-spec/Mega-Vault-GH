rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function activeSelf(uid) {
      return isSelf(uid) && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.active == true;
    }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Profiles are server-managed. Users can read their own profile only.
    match /users/{uid} {
      allow read: if (isSelf(uid) && resource.data.active != false) || isAdmin();
      allow create, update, delete: if false;
    }

    // Balances and ledger entries may only be changed by trusted Functions.
    match /wallets/{uid} {
      allow read: if activeSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /transactions/{uid}/entries/{entryId} {
      allow read: if activeSelf(uid) || isAdmin();
      allow write: if false;
    }

    // Orders are created/updated by callable Functions, never directly by a browser.
    match /orders/{orderId} {
      allow read: if (activeSelf(resource.data.uid) && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Only active packages are public. All catalog writes go through admin Functions.
    match /catalog/{catalogId}/items/{packageId} {
      // Public catalogue access is served by a callable Function which strips internal costs/codes.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentRef} {
      allow read: if (activeSelf(resource.data.uid) && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    match /referrals/{referralCode} {
      allow read: if (activeSelf(resource.data.ownerUid) && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow write: if false;
      match /members/{memberUid} {
        allow read: if (activeSelf(memberUid) || activeSelf(get(/databases/$(database)/documents/referrals/$(referralCode)).data.ownerUid)) || isAdmin();
        allow write: if false;
      }
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read: if activeSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      allow create, update, delete: if false;
      allow read: if (activeSelf(resource.data.uid) && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // Public non-secret site settings. Integration credentials are never in Firestore.
    match /settings/public {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{documentId} {
      allow read, write: if isAdmin() && documentId != 'public';
    }

    match /{document=**} { allow read, write: if false; }
  }
}
